# Copy this file to .env and fill in your own values.
# Every value here is read by backend/app/config.py.

# --- LLM provider (OpenAI-compatible) ---------------------------------
# Default targets NVIDIA NIM's hosted API catalog. Get a free API key at
# https://build.nvidia.com (no credit card needed for the free dev tier).
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-your-key-here
LLM_MODEL=meta/llama-3.1-8b-instruct
LLM_MAX_OUTPUT_TOKENS=400
LLM_TIMEOUT_SECONDS=20
LLM_TEMPERATURE=0.3

# --- Persona / branding -------------------------------------------------
# Re-personalize your fork here — no code changes needed.
ASSISTANT_NAME=Portfolio Assistant
OWNER_NAME=Jane Doe
OWNER_PRONOUNS=she/her
TONE_DESCRIPTION=friendly, professional, and concise
CONTACT_REDIRECT_MESSAGE=For anything like contact details or scheduling, please use the contact form / links elsewhere on this site rather than asking me directly.

# --- CORS -----------------------------------------------------------------
# Comma-separated list of origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:3000,https://yourportfolio.com

# --- Guardrails --------------------------------------------------------------
MAX_TURNS_PER_SESSION=20
MAX_INPUT_CHARS=2000
RATE_LIMIT_PER_MINUTE=20
SESSION_TTL_SECONDS=3600

# --- Session storage -----------------------------------------------------------
# "memory" (default; fine for a single backend instance) or "redis"
# (for forks that scale out to multiple instances).
SESSION_BACKEND=memory
REDIS_URL=

# --- Documents -------------------------------------------------------------------
DOCUMENTS_DIR=documents
